@{
    ViewData["Title"] = "Восстановление пароля";
}
<h2>Восстановление пароля</h2>
<form asp-action="ForgotPassword" method="post" class="mt-3" novalidate>
    <div class="form-group">
        <label>Email</label>
        <input type="text" name="emailOrLogin" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Отправить ссылку</button>
</form>
@if (TempData["ForgotSent"] != null)
{
    <div class="alert alert-success mt-3">Если аккаунт существует, мы отправили письмо со ссылкой для сброса пароля.</div>
}
