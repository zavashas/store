@model WebAppSportFoodStore.Controllers.OrderHistoryVm

@{
    ViewData["Title"] = "История заказов";
}

<div class="container mt-4">
    <h2>История заказов</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-info">
            <h4>У вас пока нет заказов</h4>
            <p>Сделайте свой первый заказ в нашем магазине!</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Перейти к покупкам</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var orderGroup in Model.Orders)
            {
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">№@orderGroup.Order.IdOrder</h5>
                            <span class="badge bg-primary">@orderGroup.StatusName</span>
                        </div>
                        <div class="card-body">
                            <p><strong>Дата заказа:</strong> @orderGroup.Order.FormattedOrderDate</p>
                            <p><strong>Дата доставки:</strong> @orderGroup.Order.FormattedDeliveryDate</p>
                            <p><strong>Товаров:</strong> @orderGroup.OrderDetails.Count</p>
                            <p><strong>Общая сумма:</strong> @orderGroup.TotalAmount.ToString("N2") ₽</p>

                            <div class="mt-3">
                                <h6>Товары в заказе:</h6>
                                @foreach (var item in orderGroup.OrderDetails.Take(3))
                                {
                                    <div class="d-flex align-items-center mb-2">
                                        <img src="@item.ImageUrl" alt="@item.ProductName"
                                             style="width: 80px; height: 80px; object-fit: cover;"
                                             class="rounded me-2">
                                        <div>
                                            <div class="small">@item.ProductName</div>
                                            <div class="text-muted small">@item.Quantity × @item.FormattedPrice ₽</div>
                                            <div class="text-muted small">Артикул: @item.ProductArticle</div>
                                        </div>
                                    </div>
                                }
                                @if (orderGroup.OrderDetails.Count > 3)
                                {
                                    <div class="text-muted small">и еще @(orderGroup.OrderDetails.Count - 3) товаров...</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>