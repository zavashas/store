@{
    ViewData["Title"] = "Главная — FitFuel";
}

<section class="hero-section text-white text-center py-5">
    <div class="container py-5">
        <h1 class="display-4 fw-bold mb-3">Добро пожаловать в <span class="text-info">FitFuel</span></h1>
        <p class="lead mb-4">
            Спортивное питание и добавки для энергии, роста и восстановления.
            Всё, что нужно — в одном месте.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-lg">
              Каталог товаров
            </a>
            <a asp-controller="Favorites" asp-action="Index" class="btn btn-outline-light btn-lg">
               Избранное
            </a>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light btn-lg">
                Корзина
            </a>
        </div>
    </div>
</section>

<section class="features-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Почему выбирают FitFuel</h2>
        <div class="row g-4 text-center">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <i class="bi bi-lightning-charge fs-1 text-primary mb-3"></i>
                    <h5 class="fw-bold mb-2">Доставка</h5>
                    <p class="text-muted mb-0">
                        Бесплатная доставка по всей России.
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <i class="bi bi-check-circle fs-1 text-success mb-3"></i>
                    <h5 class="fw-bold mb-2">Гарантия качества</h5>
                    <p class="text-muted mb-0">Только сертифицированные бренды и официальные поставки.</p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <i class="bi bi-people fs-1 text-warning mb-3"></i>
                    <h5 class="fw-bold mb-2">Поддержка 24/7</h5>
                    <p class="text-muted mb-0">Ответим на все вопросы, поможем подобрать питание и оформить заказ.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="support-section py-5 text-center">
    <div class="container">
        <h2 class="fw-bold mb-4">Нужна помощь?</h2>
        <p class="lead text-muted mb-4">Свяжитесь с нашей службой поддержки — мы всегда рядом.</p>

        <form asp-controller="Chat" asp-action="Index" method="post" class="d-inline">
            <button type="submit" class="btn btn-lg btn-success px-4 py-2 shadow-sm">
                <i class="bi bi-chat-dots-fill me-2"></i> Чат поддержки
            </button>
        </form>
    </div>
</section>
