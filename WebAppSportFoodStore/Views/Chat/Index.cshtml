@{
    Layout = "_Layout";
    var customerUserId = (string)ViewBag.CurrentUserId;
    var hubUrl = (string)ViewBag.ChatHubUrl;
    var apiBase = (string)ViewBag.ApiBase;
}

<div id="chat-root"
     data-hub-url="@hubUrl"
     data-api-base="@apiBase"
     data-customer-id="@customerUserId">
    <div class="container" style="max-width: 980px; margin-top: 24px;">

        <h2>Онлайн-чат</h2>

        <div class="row">
            <div class="col-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Мои чаты</span>
                        <button id="newChatBtn" class="btn btn-sm btn-success">Новый чат</button>
                    </div>
                    <div class="card-body" style="padding:0;">
                        <div class="list-group list-group-flush" id="myChatsOpen" style="max-height:220px; overflow:auto;"></div>
                        <div class="list-group-item text-muted">Закрытые</div>
                        <div class="list-group list-group-flush" id="myChatsClosed" style="max-height:220px; overflow:auto;"></div>
                    </div>
                </div>
            </div>

            <!-- Окно чата -->
            <div class="col-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span id="chatTitle">Чат не выбран</span>
                        <div class="d-flex gap-2">
                            <button id="resolveBtn" class="btn btn-sm btn-outline-success" disabled>Проблема решена</button>
                        </div>
                    </div>

                    <div id="chatBox" class="card-body"
                         style="border-radius:8px; height:420px; overflow:auto; background:#fafafa;"></div>

                    <div class="card-footer d-flex gap-2">
                        <input id="msgInput" type="text" class="form-control" placeholder="Введите сообщение..." disabled />
                        <button id="sendBtn" class="btn btn-primary" disabled>Отправить</button>
                    </div>
                </div>

                <div id="status" style="margin-top:8px; font-size:12px; color:#666;"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/chat.js"></script>
