@model WebAppSportFoodStore.Controllers.CheckoutVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Оформление заказа";
}

<div class="container py-5">
    <h1 class="h3 fw-bold mb-4">Оформление заказа</h1>

    @if (TempData["OrderError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger">@err</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card rounded-4">
                <div class="card-body">
                    <div class="h5 mb-3">Товары</div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Название</th>
                                    <th class="text-end">Цена</th>
                                    <th class="text-center">Кол-во</th>
                                    <th class="text-end">Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.Lines)
                                {
                                    <tr>
                                        <td>@l.Name</td>
                                        <td class="text-end">@l.Price.ToString("0.##") ₽</td>
                                        <td class="text-center">@l.Quantity</td>
                                        <td class="text-end">@l.Subtotal.ToString("0.##") ₽</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Итого:</th>
                                    <th class="text-end">@Model.Total.ToString("0.##") ₽</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card rounded-4 mb-3">
                <div class="card-body">
                    <div class="h5 mb-3">Адрес доставки</div>
                    @if (Model.Addresses?.Any() != true)
                    {
                        <div class="alert alert-warning mb-0">
                            У вас нет сохранённых адресов. <a href="/addresses">Добавить адрес</a>
                        </div>
                    }
                    else
                    {
                        <select id="addressId" class="form-select">
                            <option value="">— Выберите адрес —</option>
                            @foreach (var a in Model.Addresses)
                            {
                                <option value="@(a.IdAddress ?? 0)">
                                    @a.City, @a.Street, д. @a.House
                                    @if (!string.IsNullOrWhiteSpace(a.Apartament))
                                    {
                                        @:, кв. @a.Apartament
                                    }
                                </option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="card rounded-4 mb-3">
                <div class="card-body">
                    <div class="h5 mb-3">Дата доставки</div>
                    <div class="input-group">
                        <input type="text"
                               id="deliveryDate"
                               class="form-control datepicker"
                               placeholder="Выберите дату доставки"
                               readonly
                               value="@Model.DefaultDeliveryDate.ToString("dd.MM.yyyy")">
                        <span class="input-group-text">
                            <i class="bi bi-calendar3"></i>
                        </span>
                    </div>
                    <small class="text-muted mt-1 d-block">
                        Доставка доступна с @Model.MinDeliveryDate.ToString("dd.MM.yyyy")
                    </small>
                </div>
            </div>

            <div class="card rounded-4 mb-3">
                <div class="card-body">
                    <div class="h5 mb-3">Время доставки</div>
                    @if (Model.Slots?.Any() != true)
                    {
                        <div class="alert alert-warning mb-0">
                            Нет доступных временных слотов — попробуйте позже.
                        </div>
                    }
                    else
                    {
                        <select id="slotId" class="form-select">
                            <option value="">— Выберите время —</option>
                            @foreach (var s in Model.Slots)
                            {
                                <option value="@s.IdDeliverySlot">
                                    @s.TimeRange
                                </option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="card rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="h5 mb-0">Итого: @Model.Total.ToString("0.##") ₽</div>
                        <form asp-action="Place" method="post" id="placeForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="AddressId" id="AddressIdInput" />
                            <input type="hidden" name="DeliverySlotId" id="SlotIdInput" />
                            <input type="hidden" name="DeliveryDate" id="DeliveryDateInput" value="@Model.DefaultDeliveryDate.ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-success rounded-pill px-4">Оформить заказ</button>
                        </form>
                    </div>
                    <small class="text-muted">После подтверждения заказ будет создан, а корзина — очищена.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        .flatpickr-input {
            background-color: white !important;
            cursor: pointer !important;
        }

        .flatpickr-day.selected {
            background: #198754 !important;
            border-color: #198754 !important;
        }

        .flatpickr-day.today {
            border-color: #198754 !important;
        }

        .flatpickr-day.inRange {
            background: rgba(25, 135, 84, 0.1) !important;
            border-color: rgba(25, 135, 84, 0.1) !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ru.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Инициализация flatpickr
            const datePicker = flatpickr("#deliveryDate", {
                locale: "ru",
                minDate: "@Model.MinDeliveryDate.ToString("yyyy-MM-dd")",
                dateFormat: "d.m.Y",
                defaultDate: "@Model.DefaultDeliveryDate.ToString("yyyy-MM-dd")",
                disableMobile: true,
                clickOpens: true,
                allowInput: false,
                onChange: function(selectedDates, dateStr, instance) {
                    // Обновляем скрытое поле при выборе даты
                    const dateHidden = document.getElementById('DeliveryDateInput');
                    if (selectedDates[0]) {
                        const formattedDate = selectedDates[0].toISOString().split('T')[0];
                        dateHidden.value = formattedDate;
                    }
                }
            });

            const form = document.getElementById('placeForm');
            const addrSelect = document.getElementById('addressId');
            const slotSelect = document.getElementById('slotId');
            const dateInput = document.getElementById('deliveryDate');
            const addrHidden = document.getElementById('AddressIdInput');
            const slotHidden = document.getElementById('SlotIdInput');
            const dateHidden = document.getElementById('DeliveryDateInput');

            form?.addEventListener('submit', (e) => {
                const a = addrSelect?.value || '';
                const s = slotSelect?.value || '';
                const d = dateHidden?.value || '';

                if (!a || !s || !d) {
                    e.preventDefault();
                    alert('Выберите адрес, дату и время доставки.');
                    return;
                }

                addrHidden.value = a;
                slotHidden.value = s;
                // dateHidden уже обновляется через flatpickr
            });

            // Блокируем ручной ввод в поле даты
            dateInput?.addEventListener('keydown', (e) => {
                e.preventDefault();
                return false;
            });

            dateInput?.addEventListener('input', (e) => {
                e.preventDefault();
                return false;
            });
        });
    </script>
}