@model IEnumerable<APISportFoodStore.Models.ProductDto>

@{
    ViewData["Title"] = "Избранные товары";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<h2 class="mb-4 text-center">Избранные товары</h2>

@if (!Model.Any())
{
    <div class=" text-center">У вас нет избранных товаров.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model)
        {
            @await Html.PartialAsync("ProductCard", product)
        }
    </div>
}

@section Scripts {
    <script src="~/js/add-to-cart.js" defer></script>
    <script src="~/js/favorite-toggle.js" defer></script>
}