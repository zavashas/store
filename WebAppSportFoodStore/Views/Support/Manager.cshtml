@{
    Layout = "_Layout";
    var hubUrl = (string)ViewBag.ChatHubUrl;
    var apiBase = (string)ViewBag.ApiBase;
    var agentId = (string)ViewBag.AgentId;
    var isAdmin = (bool)ViewBag.IsAdmin;
}

<div id="mgr-root"
     data-hub-url="@hubUrl"
     data-api-base="@apiBase"
     data-agent-id="@agentId"
     data-is-admin="@isAdmin">
    <div class="container" style="max-width:1100px; margin-top:24px;">
        <h2>Консультант — чаты</h2>

        <div class="row">
            <div class="col-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Очередь</span>
                        <button id="refreshQueue" class="btn btn-sm btn-outline-secondary">Обновить</button>
                    </div>
                    <ul id="queueList" class="list-group list-group-flush" style="max-height:520px; overflow:auto;"></ul>
                </div>

                <div class="card mt-3">
                    <div class="card-header">Мои активные</div>
                    <ul id="activeList" class="list-group list-group-flush" style="max-height:240px; overflow:auto;"></ul>
                </div>

                <div class="card mt-3">
                    <div class="card-header">Закрытые</div>
                    <ul id="closedList" class="list-group list-group-flush" style="max-height:240px; overflow:auto;"></ul>
                </div>

            </div>

            <div class="col-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span id="chatTitle">Чат не выбран</span>
                        <div>
                            <button id="closeChatBtn" class="btn btn-sm btn-outline-danger" disabled>Закрыть чат</button>
                        </div>
                    </div>
                    <div id="chatBox" class="card-body" style="height:520px; overflow:auto; background:#fafafa;"></div>
                    <div class="card-footer d-flex gap-2">
                        <input id="msgInput" type="text" class="form-control" placeholder="Сообщение..." disabled />
                        <button id="sendBtn" class="btn btn-primary" disabled>Отправить</button>
                    </div>
                </div>
                <div id="status" class="text-muted mt-2" style="font-size:12px;"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/consultant.js"></script>
